---
import Base from '../../layouts/Base.astro';
import { portfolio } from '../../data/portfolio';
import { t } from '../../data/i18n/id';
import { Image } from 'astro:assets';

const categories = [...new Set(portfolio.map((p) => p.category))].sort();
const breakpoints = [320, 640, 960, 1280];
---
<Base title={`${t.portfolio.indexHeading} - ${t.site.name}`}>
  <section class="portfolio container">
    <h1 class="reveal">{t.portfolio.indexHeading}</h1>
    <nav class="filter" aria-label="filter by category">
      <button data-filter="all" class="active">{t.portfolio.filterAll}</button>
      {categories.map((c) => <button data-filter={c}>{c}</button>)}
    </nav>
    <div class="grid-wrap" id="grid">
      {portfolio.map((p) => (
        <a href={`/portfolio/${p.slug}/`} class={`tile reveal hover-lift cat-${p.category}`} data-category={p.category}>
          <Image
            src={p.cover}
            alt={p.title}
            widths={breakpoints}
            sizes="(max-width: 768px) 100vw, 25vw"
            loading="lazy"
            format="webp"
            class="tile-img"
          />
          <span class="tile-title">{p.title}</span>
          <span class="tile-cat">{p.category}</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .portfolio { padding-top: var(--space-5); padding-bottom: var(--section-pad); }
  h1 { font-size: var(--step-3); text-transform: uppercase; margin-bottom: var(--space-3); }
  .filter { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: var(--space-4); }
  .filter button {
    font-family: var(--font-body);
    font-size: var(--step--1);
    border: 1px solid color-mix(in srgb, var(--ink) 15%, transparent);
    background: transparent;
    color: var(--ink);
    border-radius: var(--radius-pill);
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .filter button.active, .filter button:hover { background: var(--ink); color: var(--bone); border-color: var(--ink); }
  .grid-wrap { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--space-3); }
  .tile {
    grid-column: span 3;
    background: color-mix(in srgb, var(--ink) 5%, var(--bone));
    border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    border-radius: var(--radius-card);
    padding: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .tile-img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }
  .tile-title, .tile-cat {
    padding: 0.75rem var(--space-2) 0;
  }
  .tile-cat { padding-bottom: 1rem; }
  .tile:hover .tile-title, .tile:hover .tile-cat { color: var(--bone); }
  .tile-title { font-family: var(--font-display); font-size: var(--step-0); font-weight: 600; }
  .tile-cat { font-size: var(--step--1); color: var(--crimson); text-transform: uppercase; letter-spacing: 0.1em; }
  .tile[hidden] { display: none; }
  @media (max-width: 768px) {
    .tile { grid-column: span 12; }
  }
</style>
<script>
  const grid = document.getElementById('grid')!;
  document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('button[data-filter]').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const f = btn.dataset.filter!;
      grid.querySelectorAll<HTMLElement>('[data-category]').forEach((li) => {
        li.hidden = f !== 'all' && li.dataset.category !== f;
      });
    });
  });
</script>
