---
import Base from '../layouts/Base.astro';
import { contactChannels, contact } from '../data/contact';
import { team } from '../data/team';
import { resolveT } from '../utils/i18n';
const t = resolveT('id');
---
<Base lang="id" title={`Contact - ${t.site.name}`}>
  <section class="contact container">
    <h1 class="reveal">{t.contact.heading}</h1>
    <div class="contact-grid">
      <div class="channels reveal">
        {contactChannels.map((c) => (
          <a href={c.href} class="channel hover-lift" rel="noopener">
            <span class="channel-label">{c.label}</span>
            <span class="channel-value">{c.id === 'email' ? contact.email : c.id === 'whatsapp' ? contact.phoneDisplay : contact.instagramHandle}</span>
          </a>
        ))}
      </div>
      <div class="makers reveal">
        <h2>{t.contact.makers}</h2>
        <ul>
          {team.map((m) => (
            <li>
              <a href={`https://instagram.com/${m.instagram}`} rel="noopener">{m.name}</a>
              {m.phones.length > 0 && <span class="phone">{m.phones.join(' / ')}</span>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact { padding-top: var(--space-5); padding-bottom: var(--section-pad); }
  h1 { font-size: var(--step-3); text-transform: uppercase; letter-spacing: -0.02em; margin-bottom: var(--space-4); max-width: 20ch; }
  .contact-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: var(--space-3); }
  .channels { grid-column: span 7; display: flex; flex-direction: column; gap: var(--space-2); }
  .channel {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    border-top: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    padding: var(--space-2) 0;
  }
  .channel-label { font-family: var(--font-display); font-size: var(--step-1); font-weight: 500; }
  .channel-value { font-size: var(--step-0); color: var(--crimson); }
  .makers { grid-column: span 5; }
  .makers h2 { font-size: var(--step-1); margin-bottom: var(--space-2); }
  .makers ul { list-style: none; display: grid; gap: var(--space-1); }
  .makers li { display: flex; flex-direction: column; padding: var(--space-1) 0; border-top: 1px solid color-mix(in srgb, var(--ink) 8%, transparent); }
  .makers a { color: var(--crimson); font-weight: 600; }
  .phone { font-size: var(--step--1); color: var(--muted); }
  @media (max-width: 768px) {
    .channels, .makers { grid-column: span 12; }
  }
</style>
