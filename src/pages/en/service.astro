---
import Base from '../../layouts/Base.astro';
import { services } from '../../data/services';
import { resolveT } from '../../utils/i18n';
const t = resolveT('en');
---
<Base lang="en" title={`Service - ${t.site.name}`}>
  <section class="service container">
    <h1 class="reveal">{t.service.heading}</h1>
    <ol class="service-list">
      {services.map((s, i) => (
        <li class="reveal">
          <a href={`/en/portfolio?category=${s.id}`} class="service-row hover-lift">
            <span class="num" aria-hidden="true">{s.number}</span>
            <span class="label">{s.title}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .service { padding-top: var(--space-5); padding-bottom: var(--section-pad); }
  h1 { font-size: var(--step-3); text-transform: uppercase; margin-bottom: var(--space-4); }
  .service-list { list-style: none; }
  .service-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-top: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    transition: padding-left var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  li:last-child .service-row { border-bottom: 1px solid color-mix(in srgb, var(--ink) 12%, transparent); }
  .num { font-family: var(--font-display); font-size: var(--step--1); color: var(--crimson); min-width: 3ch; }
  .label { font-family: var(--font-display); font-size: var(--step-2); font-weight: 500; text-transform: uppercase; letter-spacing: 0.02em; }
  .arrow { margin-left: auto; font-size: var(--step-1); color: var(--muted); transition: transform var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out); }
  .service-row:hover { padding-left: var(--space-2); background: color-mix(in srgb, var(--crimson) 6%, transparent); }
  .service-row:hover .arrow { color: var(--crimson); transform: translate(0.2rem, -0.2rem); }
  @media (max-width: 768px) {
    .label { font-size: var(--step-1); }
  }
</style>
